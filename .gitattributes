# These files are checked out on a Linux runner and rsynced onto a Linux VPS, or executed
# by a Linux shell. A CRLF shebang makes the kernel fail with "bad interpreter", and CRLF in
# nginx.conf/compose YAML causes subtler parse issues — pin them all to LF regardless of the
# committer's core.autocrlf setting. (The reverse proxy's Caddyfile now lives on the VPS
# itself, not in this repo, since it's shared across projects.)
deploy/docker-compose.yml text eol=lf
deploy/.env.example text eol=lf
**/Dockerfile      text eol=lf
**/.dockerignore   text eol=lf
sniplink-ui/nginx.conf text eol=lf
.github/workflows/*.yml text eol=lf
