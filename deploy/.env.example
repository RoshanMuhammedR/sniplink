# Rendered into /opt/stack/url-short/.env on the VPS by the deploy workflow.
# Never committed with real values - this file only documents what's expected.

GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Shared Postgres instance - this app's own database/credentials within it
POSTGRES_DB=url_short
POSTGRES_USER=url_short
POSTGRES_PASSWORD=

APP_BASE_URL=http://sniplink.dedyn.io
# Comma-separated list the API accepts Origin headers from - keep the bare IP alongside
# the real domain (and both schemes) so neither access path breaks.
CORS_ALLOWED_ORIGINS=http://37.187.140.45:8081,http://sniplink.dedyn.io,https://sniplink.dedyn.io
JWT_SECRET=
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_HOURS=24
JAVA_OPTS=-XX:MaxRAMPercentage=65.0
