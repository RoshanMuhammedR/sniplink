# Copy to .env on the VPS and fill in. This file lives ONLY on the server —
# it is never committed, and the deploy workflow explicitly refuses to
# overwrite it. Nothing here belongs in GitHub secrets.
#
#   cp .env.example .env && chmod 600 .env

# --- Public address -------------------------------------------------------
# The VPS is NAT'd and cannot bind 80/443. AIC Cloud's shared proxy terminates
# TLS for the domain and forwards to APP_PORT on this host, so there is no
# certificate and no DOMAIN setting to manage here — that mapping lives in the
# AIC panel (Domains -> sniplink.dedyn.io -> port 3000).

# Host port AIC's proxy forwards to. Must match the port set in their panel.
APP_PORT=3000

# Prefix used to build returned short URLs, and the only origin allowed by
# CORS. https because AIC terminates TLS. No trailing slash.
APP_BASE_URL=https://sniplink.dedyn.io

# --- Images ---------------------------------------------------------------
# GitHub account or org that owns the packages, lowercase.
GHCR_OWNER=roshanmuhammedr

# Rewritten by deploy.sh on every deploy; the value here is only the bootstrap.
IMAGE_TAG=latest

# --- Database -------------------------------------------------------------
# Generate with:  openssl rand -base64 32
POSTGRES_DB=sniplink
POSTGRES_USER=sniplink
POSTGRES_PASSWORD=change-me

# --- Tuning (optional) ----------------------------------------------------
# Defaults match application.yml; uncomment only to override.
#RATE_LIMIT_PER_MINUTE=30
#CACHE_TTL_HOURS=24
#JAVA_OPTS=-XX:MaxRAMPercentage=70.0
