# Copy to .env on the VPS and fill in. This file lives ONLY on the server —
# it is never committed, and the deploy workflow explicitly refuses to
# overwrite it. Nothing here belongs in GitHub secrets.
#
#   cp .env.example .env && chmod 600 .env

# --- Public address -------------------------------------------------------
# Hostname Caddy serves and obtains a certificate for. Must already resolve to
# this VPS. Use ":80" instead to serve plain HTTP without TLS (local testing).
DOMAIN=sniplink.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Prefix used to build the short URLs returned by the API, and the only origin
# allowed by CORS. Must match DOMAIN, including the scheme and no trailing slash.
APP_BASE_URL=https://sniplink.example.com

# --- Images ---------------------------------------------------------------
# GitHub account or org that owns the packages, lowercase.
GHCR_OWNER=your-github-username

# Rewritten by deploy.sh on every deploy; the value here is only the bootstrap.
IMAGE_TAG=latest

# --- Database -------------------------------------------------------------
# Generate the password with:  openssl rand -base64 32
POSTGRES_DB=sniplink
POSTGRES_USER=sniplink
POSTGRES_PASSWORD=change-me

# --- Tuning (optional) ----------------------------------------------------
# Defaults match application.yml; uncomment only to override.
#RATE_LIMIT_PER_MINUTE=30
#CACHE_TTL_HOURS=24
# Lower the percentage on a 1 GB box if Postgres and the JVM contend for RAM.
#JAVA_OPTS=-XX:MaxRAMPercentage=75.0
