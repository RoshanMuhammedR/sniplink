{
	# Contact address Let's Encrypt uses for expiry warnings.
	email {$ACME_EMAIL}
}

# DOMAIN comes from .env. Set it to a hostname and Caddy obtains and renews a
# certificate automatically; set it to :80 to serve plain HTTP (local testing).
{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The API surface: REST endpoints plus the springdoc assets.
	@api path /api/* /swagger-ui* /v3/api-docs* /webjars/*

	# Short links live at the web root — see RedirectController's
	# /{code:[0-9a-zA-Z]{1,10}} mapping. The alphabet excludes dots and slashes,
	# so /assets/index-abc123.js and /favicon.svg can never match, and bare /
	# needs at least one character so it still reaches the SPA.
	#
	# Deliberately `+` rather than the app's {1,10} bound: Caddy reads {...} as
	# placeholder syntax, so a counted repetition in a Caddyfile is a trap. The
	# only behavioural difference is that an 11-plus-character alphanumeric root
	# path reaches the API and gets a 404 there instead of the SPA shell — and
	# since the UI has no client-side router, no such path is ever valid.
	@code path_regexp ^/[0-9a-zA-Z]+$

	# `route` pins evaluation to the order written; without it Caddy sorts by
	# matcher specificity and the catch-all could be reached first.
	route {
		reverse_proxy @api api:8080 {
			# Overwrite rather than append. ClientIpResolver reads the LEFT-MOST
			# X-Forwarded-For entry, so if a client's own header survived to the
			# app it would control the rate-limit key and could rotate past the
			# per-IP limit at will.
			header_up X-Forwarded-For {remote_host}
		}

		reverse_proxy @code api:8080 {
			header_up X-Forwarded-For {remote_host}
		}

		# Everything else is the SPA. /actuator/** is deliberately absent: health
		# stays reachable inside the Docker network only.
		reverse_proxy ui:80
	}
}
